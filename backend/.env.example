# Copy this file to .env (same directory) and fill in your own key.
# .env is gitignored -- never commit real API keys.
#
# GEMINI_API_KEY powers the "AI Risk Analyst" narrative on POST /explain.
# It is entirely optional: if it's missing, invalid, or the Gemini API call
# fails/times out, /explain automatically falls back to a templated
# natural-language explanation built from the same risk signals, so the
# feature always works even with no key configured.
GEMINI_API_KEY=
